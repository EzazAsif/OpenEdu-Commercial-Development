# ✅ Use official Python image
FROM python:3.12.10-slim

# ✅ Set the working directory
WORKDIR /app

# ✅ Install required system packages
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# ✅ Copy all source files into the container
COPY . /app/


# ✅ Install Python dependencies
RUN bash -c "pip install --no-cache-dir -r requirements.txt & \
             pid=\$!; while kill -0 \$pid 2>/dev/null; do echo '.'; sleep 15; done; wait \$pid"

# ✅ Expose necessary ports
EXPOSE 8000 8001

# ✅ Set environment variable
ENV DJANGO_SETTINGS_MODULE=gitlms.settings

# ✅ Default CMD
CMD ["daphne", "-u", "unix:/tmp/daphne.sock", "gitlms.asgi:application"]
