# ✅ Use official Python image
FROM python:3.12.10-slim

# ✅ Set the working directory
WORKDIR /app

# ✅ Install required system packages
RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    curl \                    # ✅ Needed for wait script (you missed this before)
    && rm -rf /var/lib/apt/lists/*

# ✅ Copy all project files into the container
COPY . /app/

# ✅ Copy and make the wait script executable
COPY wait-for-elasticsearch.sh /app/wait-for-elasticsearch.sh
RUN chmod +x /app/wait-for-elasticsearch.sh

# ✅ Install Python dependencies
RUN pip install --no-cache-dir -r requirements.txt

# ✅ Expose necessary ports (Daphne & optional HTTP)
EXPOSE 8000 8001

# ✅ Set Django environment variables
ENV DJANGO_SETTINGS_MODULE=gitlms.settings

# ✅ Start Daphne server
CMD ["daphne", "-u", "unix:/tmp/daphne.sock", "gitlms.asgi:application"]
